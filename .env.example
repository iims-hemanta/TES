# Environment variables for TES 360° Evaluation System
# Copy this file to .env and adjust as needed

# Streamlit settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Default metadata (used as fallbacks in the app)
DEFAULT_SCHOOL_NAME=IIMS College - BCS (Hons)
DEFAULT_STAFF_ID=ST-1042
DEFAULT_EXPERIENCE=5.5 years
DEFAULT_QUALIFICATION=M.Sc. Computer Science
DEFAULT_PERIOD_CODE=AP2024/04

# Default stakeholder scores (used when PDF parsing fails)
DEFAULT_SELF_SCORE=62.0
DEFAULT_PEER_SCORE=58.0
DEFAULT_SUPERIOR_SCORE=60.0

# Logging level
LOG_LEVEL=INFO
